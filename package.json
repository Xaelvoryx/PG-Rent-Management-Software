{
  "name": "pg-rent-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Desktop Application for PG Rental Management",
  "workspaces": [
    "backend",
    "frontend",
    "desktop"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@playwright/test": "^1.49.1",
    "typescript": "^5.6.3"
  }
}
